# Copy this file to .env and fill in real values.
# .env is git-ignored and must NEVER be committed.

# ---- Database ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/pulse?retryWrites=true&w=majority

# ---- Security ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-me
PRESENTER_TOKEN_SECRET=replace-me

# ---- Google sign-in (optional) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Server ----
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
JOIN_ORIGIN=http://localhost:5174

# ---- AI (all free tiers; nothing here ever costs money) ----
# At least one is needed for the AI features. With none, they are hidden.
#
# Gemini — best quality, ~1500 requests/day free.
#   Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Groq — fastest, ~14400 requests/day free. Used as a fallback.
#   Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama — runs on this machine. Unlimited, offline, needs no key.
#   Install from https://ollama.com then run: ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
