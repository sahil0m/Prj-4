# Copy this file to .env and fill in real values.
# .env is git-ignored and must NEVER be committed.

# ---- Database ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/pulse?retryWrites=true&w=majority

# ---- Security ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-me
PRESENTER_TOKEN_SECRET=replace-me

# ---- Google sign-in (optional) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Server ----
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
JOIN_ORIGIN=http://localhost:5174
